#!/bin/sh
# Stand-in for OMC's alert tool. Logs every non-flag argument (title, message,
# button titles) so a case can assert what the user was told, and returns the
# button the case asked for via OMC_TEST_ALERT_RC.
#
# 0 is the OK/Continue button. The structure pre-flight treats anything else as
# "cancel", so a case that wants to prove the run stops sets OMC_TEST_ALERT_RC=1.
for a in "$@"; do
    case "$a" in
        -*) ;;
        *) printf '%s\n' "$a" >> "$OMC_TEST_LOG/alert.log" ;;
    esac
done
exit ${OMC_TEST_ALERT_RC:-0}
